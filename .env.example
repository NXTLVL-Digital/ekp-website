NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-04
SANITY_REVALIDATE_SECRET=

# Google Search Console — verification code from HTML tag method
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend — API key for contact form emails (https://resend.com/api-keys)
RESEND_API_KEY=

# Verified sending domain in Resend. Defaults to hello.emilykathryn.com.
# Set to emilykathryn.com once the root domain is verified there.
RESEND_SENDING_DOMAIN=

# Inbox that receives inquiry notifications (also the auto-responder reply-to)
NOTIFICATION_EMAIL=

# Google Analytics 4 — Measurement ID from Admin > Data Streams (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity — Project ID from clarity.microsoft.com project settings
NEXT_PUBLIC_CLARITY_PROJECT_ID=
